# ===== Microservicio de Negocio (ms_negocio) =====
NODE_ENV=development
PORT=3000

# --- Base de datos MySQL (torneos_deportivos) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=mostro
DB_PASS=
DB_NAME=torneos_deportivos

# --- Microservicio de seguridad (Spring, puerto 8181) ---
MS_SECURITY=http://localhost:8181
# true = omite validacion de permisos (SOLO desarrollo local). En produccion: false
DEV_SECURITY_BYPASS=false

# --- Microservicio de notificaciones (Flask, puerto 5000) ---
MS_NOTIFICATIONS=http://localhost:5000
# Correo destino por defecto de las notificaciones masivas a aficionados
NOTIFICATIONS_DEFAULT_RECIPIENT=aficionados@torneo.com

# --- Frontend (Vite) ---
FRONTEND_URL=http://localhost:5173
